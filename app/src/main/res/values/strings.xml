<resources>
    <string name="app_name">Perde</string>
    <string name="a11y_desc">Reads on-screen text so content can still be analyzed when the screen itself cannot be captured (private tabs). Text is kept in memory only — never stored, never sent anywhere.</string>

    <!-- Top status line: the one question the screen must answer -->
    <string name="status_on">● PROTECTION ON</string>
    <string name="status_off">○ PROTECTION OFF</string>
    <string name="status_hint_running">Screen content is analyzed on this device.</string>
    <string name="status_hint_setup">Complete the steps below first.</string>
    <string name="status_hint_ready">Ready — tap Start protection.</string>
    <string name="status_hint_stalled">It was left on but the loop has stopped. You are unprotected right now — start it again.</string>
    <string name="status_hint_stopping">Stop requested — shuts down in %1$s.</string>

